# Supabase Configuration (Required)
# Get these values from your Supabase project settings: https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Admin Access (Required)
# Comma-separated list of email addresses allowed to access the /admin configuration panel
VITE_ADMIN_EMAILS=admin@example.com

# Session Cookie Configuration (Optional - Smart Defaults Applied)
# By default, cookies are automatically set to root domain for cross-subdomain SSO:
# - auth.example.com → cookie domain: .example.com (auto SSO with app.example.com)
# - localhost → cookie domain: (none) - current host only
#
# Override defaults if needed:
# VITE_COOKIE_DOMAIN=.example.com    # Explicit domain (usually not needed)
# VITE_COOKIE_SAMESITE=Lax           # 'Lax' (default), 'Strict', or 'None'
# VITE_COOKIE_EXPIRES=30             # Days (default: 30)